# Copy to .env and fill. Used by docker-compose.yml (Portainer stack env or `docker compose`).

# Path of the isolated managed share on the NAS (host side of the volume mount).
NAS_SHARE_PATH=/volume1/WorkOS-PoC

# uid/gid of the service user that owns the tree (svc-nasagent). Find them via ADM user details
# or `id svc-nasagent`. The agent runs as this user so it is the only writer (ACL read-only for others).
AGENT_UID=1000
AGENT_GID=1000

# Measurement mode: inline (hash while streaming) | deferred (hash after rename) | off (no hash).
# Run inline first; if the 5GB LAN target is missed, re-run with off to see if sha256/CPU is the cap.
POC_HASH_MODE=inline

# Max upload size in bytes (default 5 GiB). Also capped by the token's maxSize and free disk.
MAX_UPLOAD_BYTES=5368709120

# CORS: origin(s) of the work-os app that will PUT from the browser (comma-separated), or * for the PoC.
ALLOWED_ORIGIN=*

# Agent public keys — paste the exact line printed by `node scripts/nas-poc-gen-keys.mjs`.
TOKEN_PUBLIC_KEYS=[{"kid":"poc-key-1","publicKeyPem":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"}]

# Cloudflare Tunnel token from Zero Trust -> Networks -> Tunnels -> your tunnel -> Install connector.
TUNNEL_TOKEN=
