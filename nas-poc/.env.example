# Copy to .env and fill. Used by docker-compose.yml (Portainer stack env or `docker compose`).
# `docker-compose.yml` = topologia em produção (agente em loopback + Caddy/TLS). A variante de
# túnel (`compose.tunnel.yml`, §4 do checklist) não está implementada — ver nas-poc/README.md.

# Path of the isolated managed share on the NAS (host side of the volume mount).
NAS_SHARE_PATH=/volume1/WorkOS-PoC

# uid/gid of the service user that owns the tree (svc-nasagent). Find them via ADM user details
# or `id svc-nasagent`. The agent runs as this user so it is the only writer (ACL read-only for others).
AGENT_UID=1000
AGENT_GID=1000

# Measurement mode: inline (hash while streaming) | deferred (hash after rename) | off (no hash).
# Run inline first; if the 5GB LAN target is missed, re-run with off to see if sha256/CPU is the cap.
POC_HASH_MODE=inline

# Max upload size in bytes (default 5 GiB). Also capped by the token's maxSize and free disk.
MAX_UPLOAD_BYTES=5368709120

# CORS: origin(s) of the work-os app that will PUT from the browser (comma-separated), or * for the PoC.
ALLOWED_ORIGIN=*

# Agent public keys — paste the exact line printed by `node scripts/nas-poc-gen-keys.mjs`.
TOKEN_PUBLIC_KEYS=[{"kid":"poc-key-1","publicKeyPem":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"}]

# Token da Cloudflare com escopo Zone:DNS:Edit na zona. É o que permite ao Caddy escrever o TXT do
# desafio ACME DNS-01 e emitir/renovar o certificado sozinho. OBRIGATÓRIO na topologia em produção.
CF_API_TOKEN=

# Cloudflare Tunnel token from Zero Trust -> Networks -> Tunnels -> your tunnel -> Install connector.
# Só usado pelo `compose.tunnel.yml` (§4, download externo — ainda NÃO implementado). Nem a
# produção atual nem o local/E2E precisam disto.
TUNNEL_TOKEN=

# Finalize callback (agente -> cloud). Quando setados, após gravar o arquivo o agente chama o cloud
# para marcar READY. Deixe vazio no modo PoC/load-test (só grava + 201). FINALIZE_SECRET deve ser o
# MESMO valor de NAS_FINALIZE_SECRET no work-os.
CLOUD_FINALIZE_URL=
FINALIZE_SECRET=

# --- Agente: persistência + reconcile (endurecimento grau-produção) ---
# Diretório de estado persistente (jti, fila de finalize, auditoria). Default: {NAS_ROOT}/.agent-state
STATE_DIR=
# Token dos endpoints de reconcile (LAN, auth admin). Sem ele, /v1/reconcile/* fica desabilitado (503).
RECONCILE_TOKEN=
# TTL (ms) de .uploading-*.tmp órfãos para o reconcile cleanup. Default: 86400000 (24h).
TMP_TTL_MS=
