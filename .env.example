# Database
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Provider
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- NAS artifact storage (opcional) ---
# Deixe em branco para manter upload/download NAS desabilitados. O par de chaves Ed25519 é gerado
# por: node scripts/nas-poc-gen-keys.mjs  (a PRIVADA fica aqui; a PÚBLICA vai no env do agente).
NAS_TOKEN_SIGNING_KEY=""          # Ed25519 PKCS8 PEM (privada) — o cloud ASSINA os tokens
NAS_TOKEN_KID=""                  # id da chave (rotação)
NAS_TOKEN_ISSUER="work-os"
NAS_FINALIZE_SECRET=""            # segredo HMAC do finalize (agente -> cloud)
SHARE_TOKEN_PEPPER=""             # pepper do HMAC dos tokens de share
NAS_SMB_HOST=""                   # host p/ links locais (smb:// e \\UNC)
NAS_SMB_SHARE=""                  # nome do share (ex.: WorkOS)
NAS_UNC_PREFIX=""                 # ex.: \\NAS\WorkOS (exibição)
NAS_SHARE_BASE_URL=""             # base pública de /api/artifacts/share (ex.: https://work.goonmarketing.com/api/artifacts/share)
NAS_AGENT_URL_LAN=""              # base do agente na LAN (server-side)
NAS_AGENT_URL_TUNNEL=""           # base do agente via Cloudflare Tunnel (download only)
# Espelho público (browser) para a corrida LAN vs Tunnel — NÃO secreto:
NEXT_PUBLIC_NAS_AGENT_URL_LAN=""
NEXT_PUBLIC_NAS_AGENT_URL_TUNNEL=""

# Vercel Cron (reconciliação NAS) — Bearer que a Vercel envia às rotas /api/cron/*
CRON_SECRET=""
