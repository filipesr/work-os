# Database
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"
# A porta tem que bater com o `dev` do package.json (next dev -p 3100). Em dev o
# Auth.js tolera divergência, mas um build de produção rodado localmente
# (`next start`) recusa com UntrustedHost.
NEXTAUTH_URL="http://localhost:3100"
# Só para rodar um BUILD DE PRODUÇÃO localmente (`next start`). Na Vercel o
# Auth.js confia no host sozinho; fora dela, não — e sem isto toda rota autenticada
# devolve 200 com o casco vazio e quebra depois com "Not Authenticated".
# NÃO ligue em servidor exposto: confiar no header Host cru permite envenenar o
# callback de login apontando-o para outro domínio.
# AUTH_TRUST_HOST="true"

# Google OAuth Provider
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- NAS artifact storage (opcional) ---
# Deixe em branco para manter upload/download NAS desabilitados. O par de chaves Ed25519 é gerado
# por: node scripts/nas-poc-gen-keys.mjs  (a PRIVADA fica aqui; a PÚBLICA vai no env do agente).
NAS_TOKEN_SIGNING_KEY=""          # Ed25519 PKCS8 PEM (privada) — o cloud ASSINA os tokens
NAS_TOKEN_KID=""                  # id da chave (rotação) — ex.: prod-1
NAS_TOKEN_ISSUER="work-os"        # issuer do JWT — em prod: workos.goonmarketing.com
NAS_FINALIZE_SECRET=""            # HMAC do finalize (agente -> cloud) — IGUAL ao FINALIZE_SECRET do agente
SHARE_TOKEN_PEPPER=""             # pepper do HMAC dos tokens de share
NAS_SMB_HOST=""                   # host p/ links locais (smb:// e \\UNC) — ex.: 192.168.200.216
NAS_SMB_SHARE=""                  # nome do share — ex.: WorkOS-PoC
NAS_UNC_PREFIX=""                 # ex.: \\NAS\WorkOS (exibição)
NAS_SHARE_BASE_URL=""             # base pública de /api/artifacts/share — ex.: https://workos.goonmarketing.com/api/artifacts/share
NAS_AGENT_URL_LAN=""              # base HTTPS do agente na LAN — ex.: https://nas-agent-lan.goonmarketing.com
NAS_AGENT_URL_TUNNEL=""           # base do agente via Cloudflare Tunnel (download only) — vazio se sem túnel
# Espelho público (browser) para a corrida LAN vs Tunnel — NÃO secreto (inlined no build; exige rebuild):
NEXT_PUBLIC_NAS_AGENT_URL_LAN=""      # = NAS_AGENT_URL_LAN
NEXT_PUBLIC_NAS_AGENT_URL_TUNNEL=""   # = NAS_AGENT_URL_TUNNEL (vazio se sem túnel)

# Vercel Cron (reconciliação NAS) — Bearer que a Vercel envia às rotas /api/cron/*
CRON_SECRET=""

# --- Modo TV / wallboard de presença (opcional) ---
# Conta de serviço do monitor de parede em /tv. Sem isto, /tv exige sessão de
# MANAGER/ADMIN (nunca fica aberta). Gere com: openssl rand -hex 32
# Uso: abra UMA vez /tv?token=<valor> no monitor; o token vira cookie httpOnly
# de 1 ano e a URL é limpa por redirect (sai do histórico e dos logs).
TV_WALLBOARD_TOKEN=""
