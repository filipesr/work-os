// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "wasm"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums (Global Types) ---
enum UserRole {
  ADMIN // Can configure templates and users
  MANAGER // Can manage projects and see all reports
  SUPERVISOR // Can assign tasks and manage teams
  MEMBER // Can execute tasks (Designer, Dev, etc.)
  CLIENT // Can view project status (Portal do Cliente)
}

enum TaskStatus {
  BACKLOG
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
  OBSOLETE // Demanda descartada por mudança de requisitos (arquival, fora de pendentes/%)
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ArtifactType {
  DOCUMENT // Google Doc, PDF
  IMAGE // JPG, PNG
  VIDEO // MP4 (link)
  FIGMA
  OTHER
}

// Escopo do artefato (spec 2026-07-06). Um artefato pertence a exatamente um dono conforme o
// escopo: TASK⇒taskId, PROJECT⇒projectId, CLIENT⇒clientId (invariante validada em código).
enum ArtifactScope {
  TASK
  PROJECT
  CLIENT
}

// --- Artifact / NAS upload enums (spec 2026-07-02) ---

// Tipo de mídia = pasta-folha no NAS (mapper central enum→rótulo; SOCIAL_MEDIA vira "Social Media",
// demais em minúsculas). Substitui ArtifactType na fase 2 da migração.
enum ArtifactMediaType {
  VIDEOS
  FOTOS
  DOCUMENTOS
  LOGOS
  SOCIAL_MEDIA
  OUTROS
}

// Como o artefato é armazenado: link externo (legado/atual) ou upload no NAS.
enum ArtifactStorageKind {
  LINK
  NAS_UPLOAD
}

// Máquina de estados do upload (STORED é interno do agente, não entra aqui).
enum ArtifactUploadStatus {
  PENDING
  UPLOADING
  READY
  FAILED
  EXPIRED
}

// Sensibilidade × contexto (define quem baixa interno/externo e se gera share).
enum SensitivityLevel {
  INTERNO
  CLIENTE
  CONFIDENCIAL
}

enum StageLogStatus {
  COMPLETED // Normal stage completion (advanced to next)
  REVERTED // Stage was rejected/reverted
}

enum ReworkKind {
  INTERNAL // retrabalho pego dentro do processo (gate interno) — desejável
  CLIENT // rejeição do cliente (escapou) — custosa
}

enum ReworkClass {
  DEFECT // falha de qualidade real (conta contra o FTR)
  LEGITIMATE // mudança legítima (ex.: cliente mudou direção) — NÃO conta
}

enum ActiveStageStatus {
  INACTIVE // Pre-created but not yet reached (no predecessor completed)
  ACTIVE // Ready to work - all dependencies met
  BLOCKED // Reached but waiting for remaining dependencies to complete
  COMPLETED // Work finished on this stage
}

enum ProjectStatus {
  ACTIVE // Project is active and can receive new demands
  INACTIVE // Project is deactivated (archived)
}

// --- 1. Auth & Team Models ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  // Our custom fields
  role          UserRole  @default(MEMBER)
  teams         Team[]    @relation("UserTeams")
  birthday      DateTime? // Date of birth (for birthday calendar)
  admissionDate DateTime? // Contract / admission date
  lastSeenAt    DateTime? // Track last activity for online presence

  /// Desativação de acesso. Null = ativo. Guarda QUANDO foi desativado, não um
  /// booleano: "desde quando esta pessoa não entra mais" é a pergunta que se faz
  /// depois, e um `true` não responde.
  ///
  /// Desativar NÃO apaga o usuário: comentários, horas apontadas e etapas
  /// concluídas continuam atribuídos a ele. Apagar reescreveria histórico de
  /// trabalho que realmente aconteceu (e `TaskComment` é onDelete: Cascade —
  /// sumiria com a conversa junto).
  disabledAt DateTime?

  // Capacity target: planned working hours per week. Null = no target set. The
  // productivity report divides logged TimeLog hours by this (prorated to the
  // period) to compute utilization — the denominator the app lacked before.
  weeklyCapacityHours Int?

  // Relations
  assignedTasks Task[]            @relation("Assignee")
  activeStages  TaskActiveStage[] @relation("StageAssignee")
  comments      TaskComment[]
  artifacts     TaskArtifact[]    @relation("ArtifactCreator")
  timeLogs      TimeLog[]
  stageLogs     TaskStageLog[]
  activityLogs  ActivityLog[]

  // Artifact / NAS relations
  uploadedArtifacts TaskArtifact[]      @relation("ArtifactUploader")
  deletedArtifacts  TaskArtifact[]      @relation("ArtifactDeleter")
  createdShareLinks ArtifactShareLink[]
  artifactAuditLogs ArtifactAuditLog[]

  oneOnOnesReceived    OneOnOneLog[] @relation("OneOnOneSubject")
  oneOnOnesGiven       OneOnOneLog[] @relation("OneOnOneManager")
  reworkEventsBy       ReworkEvent[] @relation("ReworkBy")
  reworkEventsAsSource ReworkEvent[] @relation("ReworkSourceAssignee")
}

model Team {
  id            String            @id @default(cuid())
  name          String            @unique
  members       User[]            @relation("UserTeams")
  defaultStages TemplateStage[] // Stages this team is default for
  // Etapas coringa roteadas para este time na criação da tarefa (override).
  routedStages  TaskActiveStage[] @relation("StageTeamOverride")
}

// --- 2. Client & Project Models ---

model Client {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  email       String?
  phone       String?
  projects    Project[]

  // Artefatos com escopo CLIENT (spec 2026-07-06). Destacados nas demandas do cliente.
  artifacts TaskArtifact[]

  // Nome da pasta-raiz do cliente na árvore do NAS. Auto-derivado do name (slug seguro);
  // editável até existir o primeiro artefato NAS, depois trava. Colisão bloqueia (fluxo admin).
  folderName String? @unique
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks       Task[]

  // Artefatos com escopo PROJECT (spec 2026-07-06). Destacados nas demandas do projeto.
  artifacts TaskArtifact[]
}

// --- 3. Workflow Template Engine Models (The "Script") ---
// This is the core of the dynamic configuration

model WorkflowTemplate {
  id          String          @id @default(cuid())
  name        String          @unique
  description String?
  createdAt   DateTime        @default(now())
  stages      TemplateStage[]
  tasks       Task[]
}

model TemplateStage {
  id         String           @id @default(cuid())
  name       String
  order      Int // The sequence (1, 2, 3...)
  templateId String
  template   WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  // SLA: expected time-in-stage in hours. Null = no SLA defined. Used by the
  // performance report to flag stages whose average duration exceeds the target.
  expectedDurationHours Int?

  // WIP limit: max concurrent ACTIVE instances of this stage (Kanban column
  // limit). Null = no limit. Enforced as a PULL constraint — claiming work in a
  // stage already at/over its limit is blocked; automatic dependency-driven
  // activation is never blocked (it may breach the limit, surfaced in the cockpit).
  wipLimit Int?

  defaultTeamId String? // The team auto-assigned (e.g., "QC")
  defaultTeam   Team?   @relation(fields: [defaultTeamId], references: [id], onUpdate: NoAction, onDelete: SetNull)

  // Etapa opcional: aparece DESMARCADA no form de criação da tarefa (o criador
  // marca só se couber na demanda). Etapas não incluídas não geram TaskActiveStage.
  optional Boolean @default(false)

  // Relations
  dependencies     StageDependency[] @relation("DependsOn")
  dependents       StageDependency[] @relation("Stage")
  activeTasks      TaskActiveStage[] @relation("ActiveTasks")
  stageLogs        TaskStageLog[]
  timeLogs         TimeLog[]
  activityLogs     ActivityLog[]
  stageArtifacts   TaskArtifact[]
  stageTransitions StageTransition[]
  reworkEvents     ReworkEvent[]     @relation("ReworkSource")
}

// This table defines the dependencies: "Stage A must be complete before Stage B"
model StageDependency {
  id               String        @id @default(cuid())
  stageId          String // The stage that has a prerequisite
  stage            TemplateStage @relation("Stage", fields: [stageId], references: [id], onDelete: Cascade)
  dependsOnStageId String // The prerequisite stage
  dependsOn        TemplateStage @relation("DependsOn", fields: [dependsOnStageId], references: [id], onDelete: Cascade)

  @@unique([stageId, dependsOnStageId])
}

// --- 4. Core Task & Collaboration Models ---
// This is the "Single Task"

model Task {
  id             String       @id @default(cuid())
  title          String
  description    String?      @db.Text
  status         TaskStatus   @default(BACKLOG)
  priority       TaskPriority @default(MEDIUM)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  dueDate        DateTime?
  // Carimbado UMA vez, na PRIMEIRA promoção para IN_PROGRESS (ver lib/task-start.ts).
  // Separa as três métricas que antes colapsavam numa só:
  //   lead time  = completedAt − createdAt (demanda → entrega, o que o cliente sente)
  //   cycle time = completedAt − startedAt (início → entrega, o que a execução controla)
  //   queue time = startedAt   − createdAt (espera na fila)
  // Null = tarefa anterior à migração 20260812... ou nunca iniciada — sai da base de
  // cycle time por decisão explícita (sem backfill: não fabricamos histórico).
  /// Início PLANEJADO, definido na criação: o prazo menos a duração somada das
  /// etapas do template, e editável pelo gestor. Não confundir com `startedAt`,
  /// que é o início REAL, carimbado quando alguém começa a trabalhar.
  ///
  /// É a diferença entre os dois que responde "esta demanda deveria já ter
  /// começado?" — sem ela, só dá para saber que atrasou depois de o prazo passar.
  plannedStartAt DateTime?

  startedAt   DateTime?
  completedAt DateTime? // Set when final stage is completed (for lead time calculation)

  // Relations
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("Assignee", fields: [assigneeId], references: [id], onUpdate: NoAction, onDelete: SetNull)

  // Task History (all in separate tables)
  activeStages     TaskActiveStage[]
  comments         TaskComment[]
  artifacts        TaskArtifact[]
  stageLogs        TaskStageLog[]
  timeLogs         TimeLog[]
  activityLogs     ActivityLog[]
  stageTransitions StageTransition[]
  reworkEvents     ReworkEvent[]

  // Tipo de trabalho: o template que a tarefa instancia. Denormalizado (fixo na
  // criação) p/ agregação/segmentação por tipo (reference-class forecasting).
  // Nullable só por causa do backfill de dados antigos.
  workflowTemplateId String?
  workflowTemplate   WorkflowTemplate? @relation(fields: [workflowTemplateId], references: [id], onDelete: SetNull)

  // Data/evento do calendário que esta demanda atende (Dia das Crianças 2026,
  // FestPop de outubro…). Null = demanda de rotina, sem vínculo com data.
  // FK de verdade, e não um slug: uma mudança no gerador de ids do catálogo não
  // pode transformar vínculos existentes em ponteiros para o nada.
  // onDelete: SetNull — apagar a data não pode levar a demanda junto.
  calendarOccurrenceId String?
  calendarOccurrence   CalendarOccurrence? @relation(fields: [calendarOccurrenceId], references: [id], onDelete: SetNull)

  @@index([workflowTemplateId, completedAt])
  @@index([calendarOccurrenceId])
}

// TaskActiveStage: Represents active/blocked/completed stages for a task
// Enables parallel workflow (fork/join) - multiple stages can be active simultaneously
model TaskActiveStage {
  id     String            @id @default(cuid())
  status ActiveStageStatus @default(ACTIVE)

  // The task this active stage belongs to
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // The stage that is active/blocked/completed
  stageId String
  stage   TemplateStage @relation("ActiveTasks", fields: [stageId], references: [id], onDelete: Cascade)

  // Assignment (per stage, not per task)
  assigneeId String?
  assignee   User?   @relation("StageAssignee", fields: [assigneeId], references: [id], onUpdate: NoAction, onDelete: SetNull)

  // --- Etapa coringa: roteamento decidido na CRIAÇÃO, não no template ---
  // Uma etapa de template sem `defaultTeamId` é deliberadamente flexível: o
  // template diz que o passo existe, não quem o executa. Sem este campo a etapa
  // nascia órfã — nenhuma fila de time a mostrava, porque toda consulta de
  // execução parte de `stage.defaultTeamId`. O time efetivo da etapa é
  // `teamId ?? stage.defaultTeamId` (ver lib/stage-team.ts); null = herda o
  // template, que continua sendo o caso da esmagadora maioria das etapas.
  teamId String?
  team   Team?   @relation("StageTeamOverride", fields: [teamId], references: [id], onUpdate: NoAction, onDelete: SetNull)

  // O que precisa ser feito NESTA instância da etapa. Existe porque a etapa
  // coringa não carrega significado do template: "Apoio" não diz nada sozinho.
  // É direcionamento do gestor para quem for pegar, não conversa — discussão
  // continua em TaskComment, que é datada e por autor.
  instructions String? @db.Text

  // Timestamps
  activatedAt DateTime  @default(now())
  completedAt DateTime?
  // Fase 2 — timestamps precisos (antes proxied por activatedAt no cockpit admin).
  blockedAt   DateTime? // Carimbado ao ENTRAR em BLOCKED — severidade de bloqueio.
  assignedAt  DateTime? // Carimbado quando o assigneeId atual foi definido — data de atribuição.

  // Unique constraint: A task cannot have the same stage active twice
  @@unique([taskId, stageId])
  // Composite indexes para queries de dashboard otimizadas
  @@index([assigneeId, status]) // getMyActiveStages: WHERE assigneeId = ? AND status = 'ACTIVE'
  @@index([stageId, assigneeId, status]) // getTeamBacklog: WHERE stageId IN (...) AND assigneeId IS NULL AND status = 'ACTIVE'
  @@index([status, completedAt]) // stats completedThisWeek: WHERE status = 'COMPLETED' AND completedAt >= ?
  @@index([taskId])
  @@index([stageId])
  @@index([assigneeId])
  @@index([status])
  @@index([teamId])
}

model TaskComment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TaskArtifact {
  id        String       @id @default(cuid())
  title     String
  url       String? // Só para storageKind = LINK (legado/atual). NAS_UPLOAD não usa url.
  type      ArtifactType @default(OTHER) // legado; removido na fase 2 da migração (usar mediaType)
  createdAt DateTime     @default(now())

  // --- Escopo (spec 2026-07-06). Exatamente um dono conforme o escopo (invariante em código). ---
  // TASK⇒taskId, PROJECT⇒projectId, CLIENT⇒clientId. Artefatos legados são TASK.
  scope ArtifactScope @default(TASK)

  taskId String? // agora nulável: PROJECT/CLIENT não têm task
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("ArtifactCreator", fields: [userId], references: [id], onDelete: Cascade)

  // --- NAS upload (spec 2026-07-02). Nulos p/ storageKind = LINK. ---
  storageKind  ArtifactStorageKind  @default(LINK)
  uploadStatus ArtifactUploadStatus @default(READY)
  mediaType    ArtifactMediaType? // NAS_UPLOAD exige (código + índice)
  purposeId    String? // legado (propósito removido do fluxo); mantido nullable
  purpose      DeliverablePurpose?  @relation(fields: [purposeId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  // Token normalizado do NOME DO ARQUIVO enviado — identidade da cadeia de versões (mesmo nome →
  // nova versão; nome diferente → artefato novo). Null p/ LINK.
  fileKey      String?
  sensitivity  SensitivityLevel     @default(INTERNO)

  stageId String?
  stage   TemplateStage? @relation(fields: [stageId], references: [id], onUpdate: NoAction, onDelete: SetNull)

  // Nome/caminho selados no prepare (imutáveis após READY). localLink é derivado (não persistido).
  nasPath          String? @unique
  fileName         String?
  originalFileName String?
  mimeType         String?
  sizeBytes        BigInt?
  checksum         String? // sha256 hex, preenchido pelo agente no finalize

  // Versionamento (spec 2026-07-06): cadeia por raiz. `rootId` = raiz da cadeia (null = a própria
  // linha é a raiz); `isCurrent` marca a versão vigente (listagens filtram isCurrent=true).
  version   Int     @default(1)
  rootId    String?
  isCurrent Boolean @default(true)

  uploadedById String?
  uploadedBy   User?   @relation("ArtifactUploader", fields: [uploadedById], references: [id], onUpdate: NoAction, onDelete: SetNull)

  readyAt      DateTime?
  failedAt     DateTime?
  failedReason String?

  deleteRequestedAt DateTime?
  deletedAt         DateTime?
  deletedById       String?
  deletedBy         User?     @relation("ArtifactDeleter", fields: [deletedById], references: [id], onUpdate: NoAction, onDelete: SetNull)

  agentId String? // qual agente/NAS gravou

  shareLinks ArtifactShareLink[]
  auditLogs  ArtifactAuditLog[]

  @@unique([taskId, fileKey, version])
  @@index([taskId])
  @@index([projectId])
  @@index([clientId])
  @@index([uploadStatus])
  @@index([rootId])
  @@index([fileKey])
}

// Propósito do entregável (tag pesquisável; compõe o nome). CRUD admin (MANAGER+).
model DeliverablePurpose {
  id        String         @id @default(cuid())
  label     String
  slug      String         @unique
  active    Boolean        @default(true)
  order     Int            @default(0)
  artifacts TaskArtifact[]
}

// Link de compartilhamento externo (só CLIENTE). Token exibido só na criação:
// nas_shr_<publicId>_<secret>; guardamos tokenHash = HMAC-SHA256(secret, SHARE_TOKEN_PEPPER).
model ArtifactShareLink {
  id               String       @id @default(cuid())
  artifactId       String
  artifact         TaskArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  publicId         String       @unique
  tokenHash        String
  passwordHash     String? // Argon2id, opcional
  expiresAt        DateTime
  maxDownloads     Int?
  downloadCount    Int          @default(0)
  lastDownloadedAt DateTime?
  createdById      String
  createdBy        User         @relation(fields: [createdById], references: [id], onUpdate: NoAction, onDelete: Cascade)
  createdByIp      String?
  revokedAt        DateTime?
  note             String?
  createdAt        DateTime     @default(now())

  @@index([artifactId])
}

// Auditoria oficial (cloud é fonte de verdade; agente tem buffer + retry).
model ArtifactAuditLog {
  id          String        @id @default(cuid())
  artifactId  String?
  artifact    TaskArtifact? @relation(fields: [artifactId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  actorUserId String?
  actor       User?         @relation(fields: [actorUserId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  eventType   String
  ip          String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime      @default(now())

  @@index([artifactId])
}

// --- 5. Reporting & Analytics Log Models (Append-Only) ---

// Log for "Time Spent" (Productivity Reports)
model TimeLog {
  id          String   @id @default(cuid())
  hoursSpent  Float
  logDate     DateTime
  description String?

  taskId  String
  task    Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stageId String? // Which stage was this time spent on?
  stage   TemplateStage? @relation(fields: [stageId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  userId  String
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Log for "Stage Transitions" (Bottleneck Reports)
model TaskStageLog {
  id        String          @id @default(cuid())
  enteredAt DateTime        @default(now())
  exitedAt  DateTime?
  status    StageLogStatus? // COMPLETED or REVERTED (null while in progress)

  taskId  String
  task    Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stageId String
  stage   TemplateStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  userId  String // The user who moved the task into this stage
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// StageTransition: append-only log of every ActiveStageStatus change for a
// (task, stage). One row is written each time a stage ENTERS a status (incl.
// creation). Durations in each status are reconstructed by pairing consecutive
// rows ordered by `at` (see lib/stage-transitions.ts). This is what enables the
// exact flow-efficiency metric (ACTIVE "touched" vs BLOCKED "waiting"), which
// the single overwritable timestamps on TaskActiveStage cannot retain across
// multiple block/unblock or revert cycles.
model StageTransition {
  id     String            @id @default(cuid())
  status ActiveStageStatus // the status the stage entered at `at`
  at     DateTime          @default(now())

  taskId  String
  task    Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stageId String
  stage   TemplateStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  // Reconstruction always scopes by (taskId, stageId) ordered by `at`.
  @@index([taskId, stageId, at])
  @@index([stageId])
}

// ReworkEvent: um registro por reversão de tarefa. Atribui o retorno à
// etapa-ORIGEM (a etapa-alvo da reversão = a que deve refazer, tipicamente onde o
// defeito nasceu) e classifica interno vs cliente. Sinal de PROCESSO (P2/P5),
// nunca individual. Append-only. byUserId é só auditoria — nunca vira métrica de pessoa.
model ReworkEvent {
  id     String     @id @default(cuid())
  at     DateTime   @default(now())
  kind   ReworkKind
  reason String     @db.Text

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  sourceStageId String
  sourceStage   TemplateStage @relation("ReworkSource", fields: [sourceStageId], references: [id], onDelete: Cascade)

  byUserId String
  byUser   User   @relation("ReworkBy", fields: [byUserId], references: [id], onDelete: Cascade)

  // Classificação humana (gestor/admin). Nulo = não-classificado → conta como
  // defeito até revisado (pessimista). LEGITIMATE sai da conta do FTR.
  reworkClass ReworkClass?

  // Quem executou a etapa-origem (assignee capturado na reversão). Base do FTR
  // por pessoa (exceção deliberada a P2 — ver spec). Nulo p/ eventos antigos ou
  // etapa sem assignee. NUNCA usado para ranking/comparação.
  sourceAssigneeId String?
  sourceAssignee   User?   @relation("ReworkSourceAssignee", fields: [sourceAssigneeId], references: [id], onDelete: SetNull)

  @@index([sourceStageId, at])
  @@index([taskId])
  @@index([sourceAssigneeId, at])
}

// OneOnOneLog: a recorded 1:1 between a manager and a team member. Powers the
// 1:1-cadence signal (days since last 1:1 per person → overdue flag), the
// Gallup-grounded people-management lever. Append-only; the latest row per
// subject is the last 1:1.
model OneOnOneLog {
  id         String   @id @default(cuid())
  occurredAt DateTime
  notes      String?
  createdAt  DateTime @default(now())

  userId String // the team member the 1:1 was with
  user   User   @relation("OneOnOneSubject", fields: [userId], references: [id], onDelete: Cascade)

  managerId String // who ran the 1:1
  manager   User   @relation("OneOnOneManager", fields: [managerId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
}

// --- 6. Real-time Activity Tracking Model ---
// This table tracks "work periods" - when a user starts/stops working on a task
// An entry with endedAt: null signifies the user's current active task
model ActivityLog {
  id        String    @id @default(cuid())
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  stageId String
  stage   TemplateStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  /// Carrega o `userId` ENQUANTO o período está aberto, e volta a null ao fechar.
  ///
  /// É o que garante UMA tarefa em execução por pessoa mesmo sob concorrência:
  /// dois cliques simultâneos não conseguem abrir dois cronômetros. O truque é o
  /// NULL — no Postgres, nulos não colidem num índice único, então os milhares de
  /// logs fechados convivem e só os abertos disputam a unicidade.
  ///
  /// Existe como coluna, e não como índice parcial em `userId WHERE endedAt IS
  /// NULL`, porque índice parcial o Prisma não declara: ele some do schema, um
  /// `db push` não o recria (comprovado numa recuperação de banco) e `migrate dev`
  /// o lê como drift e propõe derrubá-lo. Um `@unique` comum é versionado, gerado
  /// e reproduzível.
  ///
  /// INVARIANTE: não-nulo exatamente quando `endedAt` é nulo. Na aplicação há só
  /// dois pontos de escrita, ambos únicos por construção — `startWorkOnTask` abre,
  /// `closeActivityLog` fecha. Não abra nem feche por fora deles. O terceiro é o
  /// `prisma/demo-seed.ts`, que fabrica os dois estados direto.
  ///
  /// O modo de falha é assimétrico e vale conhecer: esquecer de PREENCHER ao abrir
  /// só enfraquece a garantia (a checagem em `startWorkOnTask` ainda pega o caso
  /// comum); esquecer de LIMPAR ao fechar TRAVA a pessoa — ela não consegue mais
  /// iniciar nada, e o erro aparece longe daqui, como violação de unicidade.
  openForUserId String? @unique

  // O banco também tem o índice parcial `ActivityLog_userId_open_key` (migração
  // 20260812160000), que garante o mesmo derivando de `endedAt`. Virou defesa
  // REDUNDANTE: se um `migrate dev` propuser derrubá-lo, pode aceitar — a coluna
  // acima sustenta a regra sozinha.

  @@index([userId, endedAt]) // Index for quickly finding active tasks
}

// --- 7. Calendário de datas (spec 2026-08-12) ---
// Datas comemorativas, feriados e eventos próprios. Antes viviam SÓ em código
// (lib/calendar/events.ts), o que impedia cadastrar data local ou evento
// próprio (ex.: FestPop) sem deploy.

enum EventCountry {
  AR
  BR
  PY
}

enum OccurrenceKind {
  HOLIDAY // feriado nacional
  COMMERCIAL // data comercial (Dia das Mães, Black Friday)
  EVENT // evento próprio ou local (FestPop, feira, ativação)
}

enum OccurrenceSource {
  CURATED // materializado do catálogo em código — rematerializável
  CUSTOM // cadastrado à mão; o materializador NUNCA toca nestas linhas
}

// OCORRÊNCIA-PRIMEIRO: cada edição anual é uma linha própria. "Dia das Crianças
// 2026" e "2027" têm ids distintos, então uma tarefa vinculada a uma edição não
// contamina a seguinte. Também é o que permite eventos que não são anuais nem
// recorrentes de forma calculável (FestPop acontece duas vezes por ano, em datas
// anunciadas).
//
// Toda ocorrência vale para TODOS os clientes: mesmo quem não participa do
// evento pode aproveitar o hype. Por isso não há escopo por cliente — um cliente
// sem demanda numa data é sempre um sinal legítimo, nunca ruído.
model CalendarOccurrence {
  id        String         @id @default(cuid())
  // Meia-noite UTC representando o dia no calendário de SP (convenção de lib/dates.ts).
  date      DateTime
  titlePt   String
  titleEs   String
  kind      OccurrenceKind
  // Hoje sempre os três: a operação é de fronteira e todos os clientes se
  // relacionam com AR/BR/PY. O campo existe para o dia em que isso mudar.
  countries EventCountry[]

  // Liga as edições anuais da MESMA data sem que compartilhem id — permite
  // perguntar "no ano passado a gente cobriu essa data?". Null em evento avulso.
  seriesKey String?

  source OccurrenceSource @default(CUSTOM)

  // Id determinístico do catálogo em código (`YYYY-MM-DD-slug`). É a chave de
  // deduplicação do materializador — por isso é único e existe só em CURATED.
  // O vínculo da tarefa usa o `id` (cuid), não este campo, então uma mudança no
  // slugify duplicaria linhas em vez de órfãos silenciosos.
  curatedId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@index([date])
  @@index([seriesKey])
}
