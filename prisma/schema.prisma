// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "wasm"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums (Global Types) ---
enum UserRole {
  ADMIN // Can configure templates and users
  MANAGER // Can manage projects and see all reports
  SUPERVISOR // Can assign tasks and manage teams
  MEMBER // Can execute tasks (Designer, Dev, etc.)
  CLIENT // Can view project status (Portal do Cliente)
}

enum TaskStatus {
  BACKLOG
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ArtifactType {
  DOCUMENT // Google Doc, PDF
  IMAGE // JPG, PNG
  VIDEO // MP4 (link)
  FIGMA
  OTHER
}

// Escopo do artefato (spec 2026-07-06). Um artefato pertence a exatamente um dono conforme o
// escopo: TASK⇒taskId, PROJECT⇒projectId, CLIENT⇒clientId (invariante validada em código).
enum ArtifactScope {
  TASK
  PROJECT
  CLIENT
}

// --- Artifact / NAS upload enums (spec 2026-07-02) ---

// Tipo de mídia = pasta-folha no NAS (mapper central enum→rótulo; SOCIAL_MEDIA vira "Social Media",
// demais em minúsculas). Substitui ArtifactType na fase 2 da migração.
enum ArtifactMediaType {
  VIDEOS
  FOTOS
  DOCUMENTOS
  LOGOS
  SOCIAL_MEDIA
  OUTROS
}

// Alvo da árvore de pastas: campanha (com Ano_Mes) ou institucional.
enum ArtifactTarget {
  CAMPANHA
  INSTITUCIONAL
}

// Como o artefato é armazenado: link externo (legado/atual) ou upload no NAS.
enum ArtifactStorageKind {
  LINK
  NAS_UPLOAD
}

// Máquina de estados do upload (STORED é interno do agente, não entra aqui).
enum ArtifactUploadStatus {
  PENDING
  UPLOADING
  READY
  FAILED
  EXPIRED
}

// Sensibilidade × contexto (define quem baixa interno/externo e se gera share).
enum SensitivityLevel {
  INTERNO
  CLIENTE
  CONFIDENCIAL
}

enum StageLogStatus {
  COMPLETED // Normal stage completion (advanced to next)
  REVERTED // Stage was rejected/reverted
}

enum ActiveStageStatus {
  INACTIVE // Pre-created but not yet reached (no predecessor completed)
  ACTIVE // Ready to work - all dependencies met
  BLOCKED // Reached but waiting for remaining dependencies to complete
  COMPLETED // Work finished on this stage
}

enum ProjectStatus {
  ACTIVE // Project is active and can receive new demands
  INACTIVE // Project is deactivated (archived)
}

// --- 1. Auth & Team Models ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  // Our custom fields
  role          UserRole  @default(MEMBER)
  teams         Team[]    @relation("UserTeams")
  birthday      DateTime? // Date of birth (for birthday calendar)
  admissionDate DateTime? // Contract / admission date
  lastSeenAt    DateTime? // Track last activity for online presence

  // Relations
  assignedTasks Task[]            @relation("Assignee")
  activeStages  TaskActiveStage[] @relation("StageAssignee")
  comments      TaskComment[]
  artifacts     TaskArtifact[]    @relation("ArtifactCreator")
  timeLogs      TimeLog[]
  stageLogs     TaskStageLog[]
  activityLogs  ActivityLog[]

  // Artifact / NAS relations
  uploadedArtifacts   TaskArtifact[]      @relation("ArtifactUploader")
  deletedArtifacts    TaskArtifact[]      @relation("ArtifactDeleter")
  reviewedNasProjects Project[]           @relation("NasMetadataReviewer")
  createdShareLinks   ArtifactShareLink[]
  artifactAuditLogs   ArtifactAuditLog[]
}

model Team {
  id            String          @id @default(cuid())
  name          String          @unique
  members       User[]          @relation("UserTeams")
  defaultStages TemplateStage[] // Stages this team is default for
}

// --- 2. Client & Project Models ---

model Client {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  email       String?
  phone       String?
  projects    Project[]

  // Artefatos com escopo CLIENT (spec 2026-07-06). Destacados nas demandas do cliente.
  artifacts TaskArtifact[]

  // Nome da pasta-raiz do cliente na árvore do NAS. Auto-derivado do name (slug seguro);
  // editável até existir o primeiro artefato NAS, depois trava. Colisão bloqueia (fluxo admin).
  folderName String? @unique
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks       Task[]

  // Artefatos com escopo PROJECT (spec 2026-07-06). Destacados nas demandas do projeto.
  artifacts TaskArtifact[]

  // --- Metadados de campanha p/ árvore do NAS (spec 2026-07-02) ---
  // Slug da campanha + mês/ano de VEICULAÇÃO (define a pasta permanente). Manuais, MANAGER+.
  campaignSlug  String?
  campaignYear  Int?
  campaignMonth Int?

  // Libera upload no NAS só após revisão dos metadados de campanha (default off).
  nasUploadEnabled        Boolean   @default(false)
  nasMetadataReviewedAt   DateTime?
  nasMetadataReviewedById String?
  nasMetadataReviewedBy   User?     @relation("NasMetadataReviewer", fields: [nasMetadataReviewedById], references: [id], onUpdate: NoAction, onDelete: SetNull)
}

// --- 3. Workflow Template Engine Models (The "Script") ---
// This is the core of the dynamic configuration

model WorkflowTemplate {
  id          String          @id @default(cuid())
  name        String          @unique
  description String?
  createdAt   DateTime        @default(now())
  stages      TemplateStage[]
}

model TemplateStage {
  id         String           @id @default(cuid())
  name       String
  order      Int // The sequence (1, 2, 3...)
  templateId String
  template   WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  // SLA: expected time-in-stage in hours. Null = no SLA defined. Used by the
  // performance report to flag stages whose average duration exceeds the target.
  expectedDurationHours Int?

  defaultTeamId String? // The team auto-assigned (e.g., "QC")
  defaultTeam   Team?   @relation(fields: [defaultTeamId], references: [id], onUpdate: NoAction, onDelete: SetNull)

  // Tipo de mídia sugerido para artefatos gerados nesta etapa (proveniência).
  defaultMediaType ArtifactMediaType?

  // Etapa opcional: aparece DESMARCADA no form de criação da tarefa (o criador
  // marca só se couber na demanda). Etapas não incluídas não geram TaskActiveStage.
  optional Boolean @default(false)

  // Relations
  dependencies   StageDependency[] @relation("DependsOn")
  dependents     StageDependency[] @relation("Stage")
  activeTasks    TaskActiveStage[] @relation("ActiveTasks")
  stageLogs      TaskStageLog[]
  timeLogs       TimeLog[]
  activityLogs   ActivityLog[]
  stageArtifacts TaskArtifact[]
}

// This table defines the dependencies: "Stage A must be complete before Stage B"
model StageDependency {
  id               String        @id @default(cuid())
  stageId          String // The stage that has a prerequisite
  stage            TemplateStage @relation("Stage", fields: [stageId], references: [id], onDelete: Cascade)
  dependsOnStageId String // The prerequisite stage
  dependsOn        TemplateStage @relation("DependsOn", fields: [dependsOnStageId], references: [id], onDelete: Cascade)

  @@unique([stageId, dependsOnStageId])
}

// --- 4. Core Task & Collaboration Models ---
// This is the "Single Task"

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(BACKLOG)
  priority    TaskPriority @default(MEDIUM)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  dueDate     DateTime?
  completedAt DateTime? // Set when final stage is completed (for lead time calculation)

  // Relations
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("Assignee", fields: [assigneeId], references: [id], onUpdate: NoAction, onDelete: SetNull)

  // Task History (all in separate tables)
  activeStages TaskActiveStage[]
  comments     TaskComment[]
  artifacts    TaskArtifact[]
  stageLogs    TaskStageLog[]
  timeLogs     TimeLog[]
  activityLogs ActivityLog[]
}

// TaskActiveStage: Represents active/blocked/completed stages for a task
// Enables parallel workflow (fork/join) - multiple stages can be active simultaneously
model TaskActiveStage {
  id     String            @id @default(cuid())
  status ActiveStageStatus @default(ACTIVE)

  // The task this active stage belongs to
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // The stage that is active/blocked/completed
  stageId String
  stage   TemplateStage @relation("ActiveTasks", fields: [stageId], references: [id], onDelete: Cascade)

  // Assignment (per stage, not per task)
  assigneeId String?
  assignee   User?   @relation("StageAssignee", fields: [assigneeId], references: [id], onUpdate: NoAction, onDelete: SetNull)

  // Timestamps
  activatedAt DateTime  @default(now())
  completedAt DateTime?

  // Unique constraint: A task cannot have the same stage active twice
  @@unique([taskId, stageId])
  // Composite indexes para queries de dashboard otimizadas
  @@index([assigneeId, status]) // getMyActiveStages: WHERE assigneeId = ? AND status = 'ACTIVE'
  @@index([stageId, assigneeId, status]) // getTeamBacklog: WHERE stageId IN (...) AND assigneeId IS NULL AND status = 'ACTIVE'
  @@index([status, completedAt]) // stats completedThisWeek: WHERE status = 'COMPLETED' AND completedAt >= ?
  @@index([taskId])
  @@index([stageId])
  @@index([assigneeId])
  @@index([status])
}

model TaskComment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TaskArtifact {
  id        String       @id @default(cuid())
  title     String
  url       String? // Só para storageKind = LINK (legado/atual). NAS_UPLOAD não usa url.
  type      ArtifactType @default(OTHER) // legado; removido na fase 2 da migração (usar mediaType)
  createdAt DateTime     @default(now())

  // --- Escopo (spec 2026-07-06). Exatamente um dono conforme o escopo (invariante em código). ---
  // TASK⇒taskId, PROJECT⇒projectId, CLIENT⇒clientId. Artefatos legados são TASK.
  scope ArtifactScope @default(TASK)

  taskId String? // agora nulável: PROJECT/CLIENT não têm task
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("ArtifactCreator", fields: [userId], references: [id], onDelete: Cascade)

  // --- NAS upload (spec 2026-07-02). Nulos p/ storageKind = LINK. ---
  storageKind  ArtifactStorageKind  @default(LINK)
  uploadStatus ArtifactUploadStatus @default(READY)
  mediaType    ArtifactMediaType? // NAS_UPLOAD exige (código + índice)
  purposeId    String? // NAS_UPLOAD exige
  purpose      DeliverablePurpose?  @relation(fields: [purposeId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  target       ArtifactTarget       @default(CAMPANHA)
  sensitivity  SensitivityLevel     @default(INTERNO)

  stageId String?
  stage   TemplateStage? @relation(fields: [stageId], references: [id], onUpdate: NoAction, onDelete: SetNull)

  // Nome/caminho selados no prepare (imutáveis após READY). localLink é derivado (não persistido).
  nasPath          String? @unique
  fileName         String?
  originalFileName String?
  mimeType         String?
  sizeBytes        BigInt?
  checksum         String? // sha256 hex, preenchido pelo agente no finalize
  version          Int?

  uploadedById String?
  uploadedBy   User?   @relation("ArtifactUploader", fields: [uploadedById], references: [id], onUpdate: NoAction, onDelete: SetNull)

  readyAt      DateTime?
  failedAt     DateTime?
  failedReason String?

  deleteRequestedAt DateTime?
  deletedAt         DateTime?
  deletedById       String?
  deletedBy         User?     @relation("ArtifactDeleter", fields: [deletedById], references: [id], onUpdate: NoAction, onDelete: SetNull)

  agentId String? // qual agente/NAS gravou

  shareLinks ArtifactShareLink[]
  auditLogs  ArtifactAuditLog[]

  @@unique([taskId, purposeId, mediaType, version])
  @@index([taskId])
  @@index([projectId])
  @@index([clientId])
  @@index([uploadStatus])
}

// Propósito do entregável (tag pesquisável; compõe o nome). CRUD admin (MANAGER+).
model DeliverablePurpose {
  id        String         @id @default(cuid())
  label     String
  slug      String         @unique
  active    Boolean        @default(true)
  order     Int            @default(0)
  artifacts TaskArtifact[]
}

// Link de compartilhamento externo (só CLIENTE). Token exibido só na criação:
// nas_shr_<publicId>_<secret>; guardamos tokenHash = HMAC-SHA256(secret, SHARE_TOKEN_PEPPER).
model ArtifactShareLink {
  id               String       @id @default(cuid())
  artifactId       String
  artifact         TaskArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  publicId         String       @unique
  tokenHash        String
  passwordHash     String? // Argon2id, opcional
  expiresAt        DateTime
  maxDownloads     Int?
  downloadCount    Int          @default(0)
  lastDownloadedAt DateTime?
  createdById      String
  createdBy        User         @relation(fields: [createdById], references: [id], onUpdate: NoAction, onDelete: Cascade)
  createdByIp      String?
  revokedAt        DateTime?
  note             String?
  createdAt        DateTime     @default(now())

  @@index([artifactId])
}

// Auditoria oficial (cloud é fonte de verdade; agente tem buffer + retry).
model ArtifactAuditLog {
  id          String        @id @default(cuid())
  artifactId  String?
  artifact    TaskArtifact? @relation(fields: [artifactId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  actorUserId String?
  actor       User?         @relation(fields: [actorUserId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  eventType   String
  ip          String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime      @default(now())

  @@index([artifactId])
}

// --- 5. Reporting & Analytics Log Models (Append-Only) ---

// Log for "Time Spent" (Productivity Reports)
model TimeLog {
  id          String   @id @default(cuid())
  hoursSpent  Float
  logDate     DateTime
  description String?

  taskId  String
  task    Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stageId String? // Which stage was this time spent on?
  stage   TemplateStage? @relation(fields: [stageId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  userId  String
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Log for "Stage Transitions" (Bottleneck Reports)
model TaskStageLog {
  id        String          @id @default(cuid())
  enteredAt DateTime        @default(now())
  exitedAt  DateTime?
  status    StageLogStatus? // COMPLETED or REVERTED (null while in progress)

  taskId  String
  task    Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stageId String
  stage   TemplateStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  userId  String // The user who moved the task into this stage
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- 6. Real-time Activity Tracking Model ---
// This table tracks "work periods" - when a user starts/stops working on a task
// An entry with endedAt: null signifies the user's current active task
model ActivityLog {
  id        String    @id @default(cuid())
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  stageId String
  stage   TemplateStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([userId, endedAt]) // Index for quickly finding active tasks
}
